# Copy to terraform.tfvars (git-ignored) and fill in.

# AWS CLI profile with permission to create the resources (see infra/README.md).
aws_profile = "smartfin"

# Your public IP, as a /32. Find it with:  curl https://checkip.amazonaws.com
admin_cidr = "203.0.113.7/32"

# Contents of your SSH public key. Create one with:  ssh-keygen -t ed25519 -f ~/.ssh/smartfin
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Optional
# region        = "ap-south-1"
# instance_type = "t3.medium"   # 4 GB; t3.small (2 GB) is the default
