# Written by Ansible from infra/k8s/overlays/aws/kustomization.yaml. Do not edit on the server.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: smartfin

resources:
  - ../../base

images:
  - name: smartfin-backend
    newName: {{ ecr_registry }}/smartfin-backend
    newTag: "{{ image_tag }}"
  - name: smartfin-frontend
    newName: {{ ecr_registry }}/smartfin-frontend
    newTag: "{{ image_tag }}"

configMapGenerator:
  - name: backend-config
    behavior: merge
    literals:
      - AWS_REGION={{ aws_region }}
      - SMARTFIN_UPLOADS_BUCKET={{ uploads_bucket }}
      # Bedrock through the node's IAM role. Nova in ap-south-1 is only offered through the APAC inference profile.
      - BEDROCK_MODEL_ID={{ bedrock_model_id | default('apac.amazon.nova-pro-v1:0') }}
      - SMARTFIN_AI_GUIDANCE_ENABLED={{ ai_guidance_enabled | default('true') }}

patches:
  - target:
      kind: Deployment
    patch: |-
      - op: add
        path: /spec/template/spec/imagePullSecrets
        value:
          - name: ecr-pull
