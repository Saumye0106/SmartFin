# SmartFin frontend: serves the built React app and forwards API calls to the backend,
# so the browser talks to one address. ${BACKEND_URL} is filled in when the container starts.
#
# The backend's auth routes live at the top level (/login, /register, ...), not under /api,
# so they are listed here. backend/unit_test/test_deployment.py fails if a backend route is missing.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Statement and credit report uploads are capped at 15 MB by the backend.
    client_max_body_size 16m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_smartfin;
    }

    location /uploads/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_smartfin;
    }

    location ~ ^/(login|register|register-with-otp|protected|refresh|reset-password|verify-reset-code|update-phone|get-phone|send-email-verification|check-email-verification|send-otp|verify-otp|forgot-password-otp|healthz)$ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_smartfin;
    }

    # These two addresses are both a page (GET, opened in the browser) and an API call (POST).
    location ~ ^/(forgot-password|verify-email)$ {
        error_page 418 = @backend;
        if ($request_method != GET) {
            return 418;
        }
        try_files /index.html =404;
    }

    location @backend {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/proxy_params_smartfin;
    }

    # Built assets have content hashes in their names, so they can be cached for a long time.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Everything else is a page of the single-page app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
